# Base de datos PostgreSQL (Supabase, Neon, Railway, etc.)
# Si usas el connection pooler de Supabase (puerto 6543, pgbouncer=true) para
# DATABASE_URL, DIRECT_URL debe ser la conexion directa (mismo host, puerto
# 5432, sin pgbouncer) -- las migraciones de Prisma no funcionan contra el
# pooler en modo transaccion. Si tu base de datos no usa pooler, ambas pueden
# ser el mismo valor.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-opus-4-8"
CLAUDE_EFFORT="medium"

# Twilio - https://console.twilio.com/
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Numero de WhatsApp de Twilio (sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
# Poner en "false" solo para pruebas locales con curl (sin firma real de Twilio)
TWILIO_VALIDATE_SIGNATURE="true"

# Datos de la empresa courier
COURIER_NAME="Courier CR"

# Notificacion al staff/operaciones cuando se escala una conversacion (al menos uno: WhatsApp o correo)
STAFF_WHATSAPP_NUMBER="whatsapp:+50688887777"
STAFF_EMAIL="operaciones@example.com"

# SMTP opcional para notificar al staff por correo
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Clave para proteger los endpoints /admin/* y como contraseña del panel /panel
ADMIN_API_KEY="cambia-esto-por-una-clave-larga"

PORT="3000"

# Zona horaria del proceso -- la logica de fechas (creacion de paquetes, "hoy",
# reportes, etc.) usa hora local, asi que esto debe coincidir con la zona del
# courier. Sin esto, algunos hostings (ej. Railway) corren en UTC por defecto.
TZ="America/Costa_Rica"
